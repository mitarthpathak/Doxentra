{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite"
    },
    "server": {
      "root": "server",
      "framework": "express",
      "entrypoint": "index.js",
      "includeFiles": [
        "data/tessdata/eng.traineddata",
        "lib/ocr/paddleWorker.js",
        "node_modules/@gutenye/ocr-models/assets/**",
        "node_modules/tesseract.js/src/worker-script/node/**",
        "node_modules/tesseract.js-core/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
