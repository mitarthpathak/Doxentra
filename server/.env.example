# Copy this file to server/.env and fill in the values.
# On Vercel, add the same variables under Project → Settings → Environment Variables.

# Required: Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Round-robin pool (legacy key first, then numbered keys; duplicates are ignored).
# Keep these server-only. Same-project Gemini keys SHARE quota.
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# Optional, server-only vision backup used only when Gemini page OCR fails.
# GROQ_API_KEY=
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Gemini pipeline is the default. Use legacy for a single-call Google-only comparison.
# DOXENTRA_ANALYSIS_PIPELINE=gemini
# Optional Google model overrides (stage overrides take precedence over GEMINI_MODEL):
# GEMINI_VISION_MODEL=gemini-3.5-flash-lite
# GEMINI_REASONING_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Recommended: MongoDB connection string. Without it (or if it can't connect)
# data is kept in memory and lost when the server restarts.
# If the password contains special characters such as @ : / ? #, URL-encode them (@ -> %40).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/doxentra?appName=Cluster0

# Recommended: long random string used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Recommended: Supabase Storage for the original files. The browser uploads
# straight to a signed URL, so files up to 50 MB skip Vercel's ~4.5 MB body
# limit. Without it, files go through the API (4 MB) and are kept in MongoDB
# (or in memory). The private bucket is created on first use.
# MongoDB remains the database, including job progress and PDF checkpoints.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=        (server only, never exposed to the browser)
# Legacy SUPABASE_SERVICE_ROLE_KEY is also accepted if SUPABASE_SECRET_KEY is absent.
# SUPABASE_ANON_KEY=                (optional: sent with browser uploads if your project requires it)
# SUPABASE_BUCKET=documents

# Optional: comma-separated Gemini models, tried in order (default shown).
# GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest

# Optional: only needed if the frontend is served from a different origin.
# CORS_ORIGIN=https://your-frontend.example.com

# Optional: API port for local development (default 3001).
# PORT=3001

# Dedicated local-only installation: disables cloud AI, Atlas and Supabase.
# DOXENTRA_PRIVACY_ONLY=1

# Local Node DNS recovery is automatic outside production; never enabled on Vercel.
# For a non-Vercel production process only, opt in explicitly:
# DNS_FALLBACK=1
